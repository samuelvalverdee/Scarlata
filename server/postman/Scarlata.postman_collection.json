          "name": "List reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/spots/{{spotId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["spots", "{{spotId}}", "reviews"]
