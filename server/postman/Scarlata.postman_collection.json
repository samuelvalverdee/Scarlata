              "path": ["spots", "{{spotId}}", "logs", "{{logId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Actualizado.\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "description": "Partial: only the fields you send change. Success: 200. Errors: 404 no such log on your entry."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/spots/{{spotId}}/logs/{{logId}}",
              "host": ["{{baseUrl}}"],
              "path": ["spots", "{{spotId}}", "logs", "{{logId}}"]
