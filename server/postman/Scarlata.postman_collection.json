              "path": ["spots", "{{spotId}}", "logs"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activitiesDone\": [\n    \"hiking\"\n  ],\n  \"notes\": \"Salimos a las 6am, sin lluvia.\",\n  \"photos\": [\n    {\n      \"url\": \"https://example.com/photo.jpg\"\n    }\n  ]\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "description": "BODY (all optional)\n  visitedAt       ISO date, defaults to now\n  activitiesDone  list drawn from THIS spot's activityTypes\n  notes           free text\n  photos          [{ url }], http(s) URLs only until uploads land\n\nSetup: spot marked visited. Saves the log id into {{logId}}.\nSuccess: 201, the new log\nErrors:  401, 403 not visited, 400 activity not offered by the spot / bad photo URL"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"logId\", pm.response.json()._id);"
