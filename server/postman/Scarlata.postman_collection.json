    {
      "name": "Visit logs",
      "description": "Your private record of each trip to a spot, kept on your entry. Only you can see or change your logs.\nEverything except the read needs a visit. Mounted at /spots/:id/logs.",
      "item": [
        {
          "name": "List my logs for this spot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/spots/{{spotId}}/logs",
              "host": ["{{baseUrl}}"],
              "path": ["spots", "{{spotId}}", "logs"]
