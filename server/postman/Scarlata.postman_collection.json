    {
      "name": "Gallery - admin only",
      "description": "Promoting standout visit-log photos into a spot's curated gallery. Needs role='admin'.",
      "item": [
        {
          "name": "List user photos for a spot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/spots/{{spotId}}/log-photos",
              "host": ["{{baseUrl}}"],
              "path": ["spots", "{{spotId}}", "log-photos"]
            },
            "description": "Every photo users attached to their logs for this spot, with the owner. Saves the first entryId\ninto {{entryId}} so Promote just works (copy the log id and url from the response)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "if (p.length) pm.collectionVariables.set(\"entryId\", p[0].entryId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Promote a photo to the gallery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/spots/{{spotId}}/gallery",
              "host": ["{{baseUrl}}"],
              "path": ["spots", "{{spotId}}", "gallery"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entryId\": \"{{entryId}}\",\n  \"logId\": \"{{logId}}\",\n  \"url\": \"https://example.com/photo.jpg\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "description": "BODY: entryId, logId, url (all from 'List user photos for a spot'). The photo is looked up on the\nstored log, and the credit is set to its owner.\n\nSuccess: 201, the new gallery image\nErrors:  403 not admin, 404 no such photo, 409 already in the gallery"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));"
